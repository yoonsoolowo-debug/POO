Algoritmo LeerMatrices
    Definir A, B Como Real
    Definir i, j Como Entero
    Dimension A[3,3], B[3,3]
    Para i <- 1 Hasta 3
        Para j <- 1 Hasta 3
            Escribir "A[",i,",",j,"]: "
            Leer A[i,j]
        FinPara
    FinPara
    Para i <- 1 Hasta 3
        Para j <- 1 Hasta 3
            Escribir "B[",i,",",j,"]: "
            Leer B[i,j]
        FinPara
    FinPara
    Escribir "Matrices leidas"
FinAlgoritmo