Algoritmo SumarMatrices
    Definir A, B, C Como Real
    Definir i, j Como Entero
    Dimension A[3,3], B[3,3], C[3,3]
    Para i <- 1 Hasta 3
        Para j <- 1 Hasta 3
            Escribir "A[",i,",",j,"]: "
            Leer A[i,j]
        FinPara
    FinPara
    Para i <- 1 Hasta 3
        Para j <- 1 Hasta 3
            Escribir "B[",i,",",j,"]: "
            Leer B[i,j]
        FinPara
    FinPara
    Para i <- 1 Hasta 3
        Para j <- 1 Hasta 3
            C[i,j] <- A[i,j] + B[i,j]
            Escribir "C[",i,",",j,"] = ", C[i,j]
        FinPara
    FinPara
FinAlgoritmo